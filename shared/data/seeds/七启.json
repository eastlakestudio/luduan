  {
    "phrase": "飞遁鸣高",
    "annotation": "飞遁指隐退。远离尘俗，自鸣清高。",
    "story": "飞遁离俗。",
    "source": "三国·曹植 《七启》"
  },
  {
    "phrase": "飞遁离俗",
    "annotation": "飞遁指隐退。指隐退而远离尘俗。",
    "story": "隐居大荒之庭，飞遁离俗。",
    "source": "三国·曹植 《七启》"
  },
  {
    "phrase": "返我初服",
    "annotation": "返归还；初服未做官时的衣服。比喻辞官归隐。",
    "story": "愿返初服，从子而归。",
    "source": "三国·曹植 《七启》"
  },
  {
    "phrase": "重气轻命",
    "annotation": "指看重义行而轻视生命。",
    "story": "是以雄俊之徒，交党结伦，重气轻命，感分遗身。",
    "source": "三国·曹植 《七启》"
  },
  {
    "phrase": "遗世越俗",
    "annotation": "指超脱世俗。",
    "story": "亦将有才人妙妓，遗世越俗，扬《北里》之流声，绍《阳阿》之妙曲。",
    "source": "三国·曹植 《七启》"
  },
  {
    "phrase": "珠翠之珍",
    "annotation": "指水陆所产的美味食物。",
    "story": "山鵽斥鷃，珠翠之珍。",
    "source": "三国·曹植 《七启》"
  },
  {
    "phrase": "国富民丰",
    "annotation": "国家富有，民众富裕。",
    "story": "散乐移风，国富民康。",
    "source": "三国·曹植 《七启》"
  }
]