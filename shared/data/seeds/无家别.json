  {
    "phrase": "近行止一身",
    "annotation": "出自《无家别》，唐朝·杜甫。",
    "story": "近行止一身，远去终转迷。",
    "source": "唐朝·杜甫 《无家别》"
  },
  {
    "phrase": "我里百余家",
    "annotation": "出自《无家别》，唐朝·杜甫。",
