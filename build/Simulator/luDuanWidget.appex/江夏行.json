  {
    "phrase": "娇小玲珑",
    "annotation": "玲珑伶俐可爱。形容身材小巧、伶俐可爱的样子。",
    "story": "忆惜娇小婆，春心亦自持。",
    "source": "唐朝·李白 《江夏行》"
  },
  {
    "phrase": "东家西舍",
    "annotation": "犹言左邻右舍。住在左右前后的街坊邻居。",
    "story": "东家西舍同时发，北去南来不逾月。未知行李游何方，作个音书能断绝。",
    "source": "唐朝·李白 《江夏行》"
  }
